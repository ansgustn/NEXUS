# ==============================================================================
# [NEXUS] 환경 설정 파일 (.env.example)
# 복사하여 .env 로 이름을 변경한 뒤 사용하세요. (실행 파일 run_nexus.bat 실행 시 자동 생성됨)
# ==============================================================================

# 1. ComfyUI AI 인퍼런스 서버 URL
# - 동일한 PC에서 실행하는 경우: http://127.0.0.1:8188
# - 별도의 데스크탑 GPU PC에서 실행하는 경우: http://<데스크탑_IPv4_주소>:8188 (예: http://192.168.0.25:8188)
COMFYUI_URL=http://127.0.0.1:8188

# 2. NEXUS Node.js 백엔드 서버 포트 (기본값: 3001)
PORT=3001

# 3. (선택) Ollama 로컬 LLM 설정 (실시간 질의응답 시 사용)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# 4. (선택) WebRTC 실시간 아바타 서버 포트 (기본값: http://localhost:8010)
WEBRTC_SERVER_URL=http://localhost:8010
